# Optional. Without it the map runs on bundled outlines only.
VITE_MAPBOX_TOKEN=
# Optional opening pin as lon,lat. Defaults to a generic Boston point.
VITE_DEFAULT_PIN=
# Optional. Google Maps Platform key for the Place tab (Places API (New) + Street View
# Static API). Server-side only: no VITE_ prefix, so it never reaches the browser bundle;
# the dev/preview proxy in vite.config.ts adds it. Restart `npm run dev` after setting it.
GOOGLE_MAPS_API_KEY=
